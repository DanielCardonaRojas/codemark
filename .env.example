# GitHub OAuth Configuration
# Get these from your GitHub OAuth App settings
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# JWT Secret for signing session tokens (generate a secure random string)
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-characters-long

# Production deployment (used by docker-compose + Caddy)
# Set to your domain for automatic HTTPS via Let's Encrypt
DOMAIN=tours.example.com
